generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A bookable community facility. Instants are stored as UTC timestamps and
/// displayed in the facility's IANA time zone.
model Facility {
  id               String           @id @default(uuid(7)) @db.Uuid
  slug             String           @unique
  name             String
  sport            String
  timeZone         String           @map("time_zone")
  requiresApproval Boolean          @default(false) @map("requires_approval")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  openingHours     OpeningHours[]
  scheduleEntries  ScheduleEntry[]
  bookings         Booking[]
  bookingAttempts  BookingAttempt[]

  @@map("facility")
}

/// What occupies a schedule entry's time. The public schedule shows only the
/// kind; the requester and reason stay private.
enum ScheduleEntryKind {
  /// A pending booking request holding its slot until it expires.
  hold
  /// A confirmed booking.
  booking
  /// A published community event.
  event
  /// An Admin block that replaced a booking.
  block
  /// A maintenance closure.
  closure
}

/// Time a facility cannot be booked. Ranges are start-inclusive and
/// end-exclusive, so adjacent entries may share an endpoint.
model ScheduleEntry {
  id         String            @id @default(uuid(7)) @db.Uuid
  facilityId String            @map("facility_id") @db.Uuid
  kind       ScheduleEntryKind
  startsAt   DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime          @map("ends_at") @db.Timestamptz(3)
  /// When a hold stops occupying time. Reads ignore expired holds even
  /// before cleanup removes them.
  expiresAt  DateTime?         @map("expires_at") @db.Timestamptz(3)
  /// Requester or blocked user. Private.
  accountId  String?           @map("account_id")
  /// Internal reason for an event, block or closure. Private.
  reason     String?
  /// The booking a hold or booking entry belongs to.
  bookingId  String?           @unique @map("booking_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  facility   Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  account    User?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  booking    Booking?          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([facilityId, startsAt])
  @@map("schedule_entry")
}

enum BookingStatus {
  /// Waiting for Admin approval; holds its time until expiresAt.
  pending
  confirmed
  /// A pending request whose deadline passed before approval.
  expired
}

/// A request for one facility time range. Its schedule entry occupies the
/// time while the booking is pending or confirmed; history stays here.
model Booking {
  id            String           @id @default(uuid(7)) @db.Uuid
  facilityId    String           @map("facility_id") @db.Uuid
  accountId     String           @map("account_id")
  startsAt      DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime         @map("ends_at") @db.Timestamptz(3)
  status        BookingStatus
  /// Approval deadline for a pending request: the earlier of 24 hours after
  /// submission and the start.
  expiresAt     DateTime?        @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  facility      Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  account       User             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  scheduleEntry ScheduleEntry?
  attempts      BookingAttempt[]

  @@index([accountId, facilityId, status])
  @@map("booking")
}

/// One booking submission, keyed by the client's Idempotency-Key. A retry
/// with the same key replays the recorded response instead of booking again.
model BookingAttempt {
  id         String   @id @default(uuid(7)) @db.Uuid
  accountId  String   @map("account_id")
  key        String
  facilityId String   @map("facility_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  statusCode Int      @map("status_code") @db.SmallInt
  response   Json
  bookingId  String?  @map("booking_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  account    User     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([accountId, key])
  @@map("booking_attempt")
}

/// Weekly opening window in the facility's local time. Minutes count from
/// local midnight and align to 30-minute booking slots.
model OpeningHours {
  id          String   @id @default(uuid(7)) @db.Uuid
  facilityId  String   @map("facility_id") @db.Uuid
  /// ISO weekday: 1 is Monday, 7 is Sunday.
  weekday     Int      @db.SmallInt
  opensAtMin  Int      @map("opens_at_min") @db.SmallInt
  closesAtMin Int      @map("closes_at_min") @db.SmallInt
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, weekday])
  @@map("opening_hours")
}

enum AccountStatus {
  pending
  active
  revoked
}

enum Role {
  resident
  staff
  admin
}

/// Better Auth user. Identity comes from Google; status and role belong to
/// the application and are never accepted from sign-in input.
model User {
  id              String           @id
  name            String
  email           String           @unique
  emailVerified   Boolean          @default(false) @map("email_verified")
  image           String?
  status          AccountStatus    @default(pending)
  role            Role?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions        Session[]
  accounts        Account[]
  auditEntries    AuditLog[]       @relation("AuditActor")
  scheduleEntries ScheduleEntry[]
  bookings        Booking[]
  bookingAttempts BookingAttempt[]
  provision       AdminProvision?

  @@index([status])
  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Linked identity. For Google, providerId is "google" and accountId is the
/// OpenID Connect subject.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

/// The one-time first Admin grant. A single row may ever exist; it records
/// the exact OpenID Connect issuer and subject and when it was used.
model AdminProvision {
  id         Int       @id @default(1) @db.SmallInt
  issuer     String
  subject    String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  userId     String?   @unique @map("user_id")
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("admin_provision")
}

enum AuditAction {
  admin_provisioned
  admin_bootstrapped
  account_approved
  account_role_changed
  account_revoked
}

/// Privileged account and schedule changes. Actor is null for operator
/// commands run outside a signed-in session.
model AuditLog {
  id         String      @id @default(uuid(7)) @db.Uuid
  actorId    String?     @map("actor_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  details    Json        @default("{}")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
