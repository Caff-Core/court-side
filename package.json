{
  "name": "court-side",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:deploy": "turbo db:deploy",
    "db:seed": "turbo db:seed",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "db:reset": "bun run --cwd apps/server db:reset"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.2"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
