# Copy to .env for local development. Values are fictional local defaults.

# PostgreSQL from compose.yaml. Host port 5433 avoids clashing with a local
# PostgreSQL on 5432.
POSTGRES_USER=court_side
POSTGRES_PASSWORD=court_side
POSTGRES_DB=court_side
POSTGRES_PORT=5433
DATABASE_URL=postgresql://court_side:court_side@localhost:5433/court_side

# Same-origin setup: the browser only talks to APP_URL. In development Vite
# serves the web app there and proxies /api to the NestJS server on PORT. In
# production NestJS serves both the built web app and /api on PORT.
# WEB_PORT is the Vite port in APP_URL; Vite refuses to start if it is taken.
APP_URL=http://localhost:5173
WEB_PORT=5173
PORT=3000

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=YjkTjdfuUucdod8XETGPpTBgLQu/hlkHBIwebOlFOrc=

# Google OpenID Connect client. Leave empty to run without Google; the
# sign-in screen then offers only the identity fixture when it is enabled.
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local identity fixture: sign in as fictional personas without Google.
# For tests and the offline demo only; the server refuses it in production.
AUTH_IDENTITY_FIXTURE=true
