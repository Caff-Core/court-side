# Copy to .env for local development. Values are fictional local defaults.

# PostgreSQL from compose.yaml. Host port 5433 avoids clashing with a local
# PostgreSQL on 5432.
POSTGRES_USER=court_side
POSTGRES_PASSWORD=court_side
POSTGRES_DB=court_side
POSTGRES_PORT=5433
DATABASE_URL=postgresql://court_side:court_side@localhost:5433/court_side

# Same-origin setup: the browser only talks to APP_URL. In development Vite
# serves the web app there and proxies /api to the NestJS server on PORT. In
# production NestJS serves both the built web app and /api on PORT.
APP_URL=http://localhost:5173
PORT=3000
